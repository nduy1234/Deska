# Server-side only. Never prefix these with VITE_ (that would ship them to the browser).
# Provider: llama (default) | openai | anthropic | mock
LLM_PROVIDER=llama
# Optional model override (defaults: Llama-4-Maverick-17B-128E-Instruct-FP8 / gpt-4o-mini / claude-haiku-5-5)
LLM_MODEL=
# Provider API key (LLAMA_API_KEY is also accepted for the llama provider)
LLM_API_KEY=
# Optional base URL for openai-compatible hosts, e.g. https://api.llama.com/compat/v1
LLM_BASE_URL=
